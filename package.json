{
  "name": "dsh-dokuwiki",
  "version": "0.4.1",
  "description": "DokuWiki integration for DeepSeek Harness: read, search, write, delete wiki pages and upload media through native tools, with ACL-aware tool exposure, an optional per-wiki writing-conventions page, and credentials managed by DSH.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dokuwiki",
    "wiki",
    "knowledge-base"
  ],
  "icon": "icon.svg",
  "license": "MIT",
  "author": "ycAlphi (https://github.com/ycAlphi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycAlphi/dsh-dokuwiki.git"
  },
  "homepage": "https://github.com/ycAlphi/dsh-dokuwiki#readme",
  "bugs": {
    "url": "https://github.com/ycAlphi/dsh-dokuwiki/issues"
  },
  "scripts": {
    "test": "node --test test/client.test.mjs test/dokuwiki.test.mjs test/plugin.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:local": "node test/local-integration.mjs",
    "pack:check": "npm pack --dry-run"
  }
}
